set traceDisplay = long.

(* --- Parameter --- *)
free ID_MS: bitstring [private].
free K_MS: bitstring [private].
free K_RC: bitstring [private].

(* MODEL-ONLY: ProVerif weaksecret requires a private free name, not a locally bound new name. *)
free PW_i: bitstring [private].

free URi_table: bitstring [private].
free MS_table: bitstring [private].

(* --- Channel --- *)
free pch: channel.

(* --- Database --- *)
table MS_DB(bitstring, bitstring, bitstring, bitstring).
table URi_DB(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).

(* --- Function --- *)
(* MODEL-ONLY: explicit fixed-width XOR slices for the concatenated Wi. *)
fun slice_r(bitstring): bitstring.
fun slice_rp(bitstring): bitstring.
fun h(bitstring): bitstring.
fun xor(bitstring, bitstring): bitstring.
fun puf(bitstring): bitstring [private].
fun bio_gen_bk(bitstring): bitstring.
fun bio_gen_rp(bitstring): bitstring.
fun computeVe(bitstring): bitstring. (* --- Vi^a XOR Vi^b ---*)

fun aead_enc(bitstring, bitstring, bitstring, bitstring): bitstring. (* --- AEAD Encryption ---*)
fun aead_tag(bitstring, bitstring, bitstring, bitstring): bitstring. (* --- AEAD Tag Generation ---*)
reduc forall n:bitstring, a:bitstring, m:bitstring, k:bitstring;
  aead_dec(n, a, aead_enc(n, a, m, k), aead_tag(n, a, m, k), k) = m. (* --- AEAD Descryption ---*)

reduc forall b:bitstring;
  bio_rep(b, bio_gen_rp(b)) = bio_gen_bk(b).
equation forall x:bitstring, y:bitstring;
  xor(xor(x,y),y) = x.

(* --- Event --- *)
event URi_Local_Start().
event URi_Local_End().
event MS_Auth_URi(bitstring, bitstring, bitstring, bitstring).
event URi_Auth_MS(bitstring, bitstring, bitstring, bitstring).
event SK_Est_MS(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
event SK_Est_URi(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).

(* MODEL-ONLY authentication instrumentation; no cryptographic message changed. *)
event URi_Request_Sent(bitstring, bitstring, bitstring, bitstring, bitstring).
event MS_Request_Accepted(bitstring, bitstring, bitstring, bitstring, bitstring).

(* --- Local & Authentication & Key exchange Phase --- *)
let URi_LocalAndAuth_step(ID_i':bitstring, PW_i':bitstring, BIO_i':bitstring) =
  event URi_Local_Start();
  get URi_DB(=URi_table, TID_i, Wi, CT_i, TAG_i, MX2) in
  let Vi' = h((ID_i', PW_i')) in
  let (Wi_r:bitstring, Wi_rp:bitstring) = Wi in
  let ri' = xor(Wi_r, slice_r(Vi')) in
  let RP_i' = xor(Wi_rp, slice_rp(Vi')) in
  let BK_i' = bio_rep(BIO_i', RP_i') in
  let EK_i' = xor(computeVe(Vi'), BK_i') in

  let (PID_i:bitstring, Ki:bitstring) =
      aead_dec(ri', ID_i', CT_i, TAG_i, EK_i') in

  event URi_Local_End(); (*Authentication step1*)
  let Pi = puf(Ki) in
  let X_i = xor(MX2, h((Pi, PID_i))) in
  new RN_i:bitstring;
  new TS1:bitstring;
  new N1:bitstring;
  let A1 = TID_i in
  let PT1 = (RN_i, PID_i) in
  let CT_1 = aead_enc(N1, A1, PT1, X_i) in
  let TAG1 = aead_tag(N1, A1, PT1, X_i) in
  event URi_Request_Sent(RN_i, X_i, PID_i, TID_i, N1);
  out(pch, (TS1, CT_1, TAG1, TID_i, N1)); (*Authentication step2*)

  in(pch, (TS2:bitstring, CT_2:bitstring, TAG2:bitstring, N2:bitstring));

  let (RN_MS':bitstring, RN_i_check:bitstring) =
      aead_dec(N2, PID_i, CT_2, TAG2, X_i) in
  if (RN_i = RN_i_check) then
    event URi_Auth_MS(RN_i, RN_MS', X_i, PID_i);
    let SK_URi = h((RN_MS', RN_i, X_i)) in
    event SK_Est_URi(RN_i, RN_MS', X_i, PID_i, ID_MS, SK_URi). (*URi established session key and Authentication step5*)

let MS_Auth_step() =
  in(pch, (TS1:bitstring, CT_1:bitstring, TAG1:bitstring,
           TID_i:bitstring, N1:bitstring));
  get MS_DB(=MS_table, TID_i_new, TID_i_old, MX1) in

  if (TID_i = TID_i_new) then
    let P_MS = puf(K_MS) in
    let X_i = xor(MX1, h((P_MS, ID_MS))) in

    let (RN_i':bitstring, PID_i':bitstring) =
        aead_dec(N1, TID_i, CT_1, TAG1, X_i) in

    event MS_Request_Accepted(RN_i', X_i, PID_i', TID_i, N1);
    new RN_MS:bitstring;
    new TS2:bitstring;
    new N2:bitstring;
    event MS_Auth_URi(RN_i', RN_MS, X_i, PID_i'); (*Authentication stpe3*)

    let A3 = PID_i' in
    let PT2 = (RN_MS, RN_i') in
    let CT_2 = aead_enc(N2, A3, PT2, X_i) in
    let TAG2 = aead_tag(N2, A3, PT2, X_i) in
    let SK_MS = h((RN_MS, RN_i', X_i)) in
    event SK_Est_MS(RN_i', RN_MS, X_i, PID_i', ID_MS, SK_MS); (*MS established session key*)
    out(pch, (TS2, CT_2, TAG2, N2)). (*Authentication step4*)

(* --- Query --- *)
query attacker(K_MS).
query attacker(K_RC).
query attacker(ID_MS).

query inj-event(URi_Local_End()) ==> inj-event(URi_Local_Start()).
query rni:bitstring, rnms:bitstring, xi:bitstring, pid:bitstring;
  inj-event(URi_Auth_MS(rni, rnms, xi, pid)) ==>
  inj-event(MS_Auth_URi(rni, rnms, xi, pid)).

query pid:bitstring, id:bitstring, rni:bitstring, rnms:bitstring,
      xi:bitstring, sk:bitstring;
  event(SK_Est_MS(rni, rnms, xi, pid, id, sk)).
query pid:bitstring, id:bitstring, rni:bitstring, rnms:bitstring,
      xi:bitstring, sk:bitstring;
  event(SK_Est_URi(rni, rnms, xi, pid, id, sk)).
query pid:bitstring, id:bitstring, rni:bitstring, rnms:bitstring,
      xi:bitstring, sk_ms:bitstring, sk_uri:bitstring;
  event(SK_Est_MS(rni, rnms, xi, pid, id, sk_ms)) &&
  event(SK_Est_URi(rni, rnms, xi, pid, id, sk_uri)) ==> sk_ms = sk_uri.
query pid:bitstring, id:bitstring, rni:bitstring, rnms:bitstring,
      xi:bitstring, sk:bitstring;
  event(SK_Est_MS(rni, rnms, xi, pid, id, sk)) && attacker(sk).
query pid:bitstring, id:bitstring, rni:bitstring, rnms:bitstring,
      xi:bitstring, sk:bitstring;
  event(SK_Est_URi(rni, rnms, xi, pid, id, sk)) && attacker(sk).

(* MODEL-ONLY: Offline guessing of PW with known ID and stolen user memory. *)
weaksecret PW_i.
query attacker(PW_i).

(* MODEL-ONLY: reverse-direction, non-injective origin authentication. *)
query rni:bitstring, xi:bitstring, pid:bitstring, tid:bitstring, n1:bitstring;
  event(MS_Request_Accepted(rni, xi, pid, tid, n1)) ==>
  event(URi_Request_Sent(rni, xi, pid, tid, n1)).

(* MODEL-ONLY: User key establishment implies matching MS key establishment. *)
query rni:bitstring, rnms:bitstring, xi:bitstring,
      pid:bitstring, id:bitstring, sk:bitstring;
  event(SK_Est_URi(rni, rnms, xi, pid, id, sk)) ==>
  event(SK_Est_MS(rni, rnms, xi, pid, id, sk)).

(* --- Process --- *)
process
  new ID_i:bitstring;
  new BIO_i:bitstring;
  new Ki:bitstring;
  new ri:bitstring;
  new TID_i_old:bitstring;
  new TID_i_new:bitstring;

  let TID_i = TID_i_new in
  let PID_i = h((ID_i, ID_MS, K_MS)) in
  let X_i = h((K_RC, PID_i, ID_MS, ri)) in

  (*Medical server*)
  let P_MS = puf(K_MS) in
  let MX1 = xor(X_i, h((P_MS, ID_MS))) in
  insert MS_DB(MS_table, TID_i_new, TID_i_old, MX1);

  (*User*)
  let BK_i = bio_gen_bk(BIO_i) in
  let RP_i = bio_gen_rp(BIO_i) in
  let Vi = h((ID_i, PW_i)) in
  let Wi = (xor(ri, slice_r(Vi)), xor(RP_i, slice_rp(Vi))) in
  let EK_i = xor(computeVe(Vi), BK_i) in
  let PT_i = (PID_i, Ki) in
  let CT_i = aead_enc(ri, ID_i, PT_i, EK_i) in
  let TAG_i = aead_tag(ri, ID_i, PT_i, EK_i) in
  let Pi = puf(Ki) in
  let MX2 = xor(X_i, h((Pi, PID_i))) in
  insert URi_DB(URi_table, TID_i, Wi, CT_i, TAG_i, MX2);

  (* MODEL-ONLY: attacker physically copies persistent user-device memory and knows ID. *)
  out(pch, (TID_i, Wi, CT_i, TAG_i, MX2, ID_i));

  ((!URi_LocalAndAuth_step(ID_i, PW_i, BIO_i)) | (!MS_Auth_step()))
